# Copy to .env (never commit .env). All settings are optional; defaults shown.
SMEAR_DATA_DIR=/app/data
SMEAR_MODELS_DIR=/data/models
SMEAR_STORAGE_DIR=/data/storage
SMEAR_IMAGE_SIZE=128
SMEAR_DECISION_THRESHOLD=0.5
SMEAR_LOW_CONFIDENCE_MARGIN=0.15
SMEAR_MAX_UPLOAD_BYTES=5242880
SMEAR_RETRAIN_MIN_NEW_SAMPLES=20
SMEAR_RETRAIN_MAX_EPOCHS=6
SMEAR_RETRAIN_LEARNING_RATE=0.00001
SMEAR_GATE_MAX_F1_DROP=0.005
SMEAR_GATE_MAX_RECALL_DROP=0.01
SMEAR_DRIFT_PSI_ALERT=0.2
SMEAR_CORS_ORIGINS=*
SMEAR_LOG_LEVEL=INFO
